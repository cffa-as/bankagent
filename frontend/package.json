{
  "name": "vaultline-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "dev": "node scripts/check-runtime.mjs && next dev --webpack",
    "build": "node scripts/check-runtime.mjs && next build --webpack",
    "start": "node scripts/check-runtime.mjs && next start",
    "typecheck": "node scripts/check-runtime.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "1.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
