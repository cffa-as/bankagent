  "passport": {
    "duration": 21.483,
    "sentences": [
      {
        "text": "每一笔动作，都附带三枚服务端证据。",
        "start": 0.1,
        "end": 3.371
      },
      {
        "text": "Source，说明输入是否可信、是否完成注入检查。",
        "start": 3.321,
        "end": 7.647
      },
      {
        "text": "Identity，记录动作绑定 MFA 的状态、次数和锁定。",
        "start": 7.647,
        "end": 12.5
      },
      {
        "text": "Receipt，只有银行业务工具返回回执，才算成功。",
        "start": 12.5,
        "end": 16.838
      },
      {
        "text": "任何单一验证信号，都不能独立授权高风险资金动作。",
        "start": 16.838,
        "end": 21.483
      }
    ]
  },
