  "tiers": {
    "duration": 18.223,
    "sentences": [
      {
        "text": "Vaultline 把动作分成三级。",
        "start": 0.1,
        "end": 2.771
      },
      {
        "text": "绿色查询，确认意图后自动执行。",
        "start": 2.721,
        "end": 6.029
      },
      {
        "text": "黄色动作，展示详情，明确确认后执行。",
        "start": 6.029,
        "end": 9.988
      },
      {
        "text": "红色动作，必须完成与本笔业务绑定的多因子验证。",
        "start": 9.988,
        "end": 14.449
      },
      {
        "text": "级别由服务端规则判定，模型无权改动。",
        "start": 14.449,
        "end": 18.223
      }
    ]
  },
  "green-1": {
    "duration": 6.496,
    "sentences": [
      {
