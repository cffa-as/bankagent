{
  "name": "vaultline-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "record": "node scripts/check-runtime.mjs && node scripts/record-demo.mjs",
    "score": "python3 scripts/generate-score.py 300",
    "dev": "node scripts/check-runtime.mjs && remotion studio src/index.ts",
    "render": "node scripts/check-runtime.mjs && remotion render src/index.ts VaultlineProduct ../frontend/public/demo/vaultline-product.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "poster": "node scripts/check-runtime.mjs && python3 scripts/make-cover.py",
    "typecheck": "node scripts/check-runtime.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "playwright": "1.64.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3"
  }
}
